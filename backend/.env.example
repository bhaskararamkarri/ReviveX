# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/revivex
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Razorpay Webhook Secrets & API Credentials
RAZORPAY_WEBHOOK_SECRET=your_test_secret_here
RAZORPAY_LIVE_RECOVERY_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_yourkeyhere
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# AI Configuration (NVIDIA NIM or OpenRouter)
AI_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# OpenRouter / OpenAI Fallback Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3-8b-instruct:free
